# Required API Keys
ANTHROPIC_API_KEY="your-anthropic-api-key" # Needed if proxying *to* Anthropic
OPENAI_API_KEY="your-openai-key"
GEMINI_API_KEY="your-google-ai-studio-key"
NVIDIA_NIM_API_KEY="nvapi-your-key"
# Optional: Provider Preference and Model Mapping
# Controls which provider (google, openai, anthropic, or nvidia_nim) is preferred for mapping haiku/sonnet.
# Defaults to openai if not set.
# Set to "anthropic" for "just an Anthropic proxy" mode (no remapping)
# Set to "nvidia_nim" for NVIDIA NIM: no openai/gemini/anthropic prefix; model id sent as-is (e.g. z.ai/glm4.7)
PREFERRED_PROVIDER="openai"
OPENAI_BASE_URL="https://api.openai.com/v1"

# NVIDIA NIM (only when PREFERRED_PROVIDER=nvidia_nim). Model names are NOT prefixed.
# If BIG_MODEL/SMALL_MODEL are unset, they default to z.ai/glm4.7 for nvidia_nim.
# NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"


# Optional: Specify the exact models to map haiku/sonnet to.
# If PREFERRED_PROVIDER=google, these MUST be valid Gemini model names known to the server.
# Defaults to gemini-2.5-pro and gemini-2.5-flash if PREFERRED_PROVIDER=google.
# Defaults to gpt-4.1 and gpt-4.1-mini if PREFERRED_PROVIDER=openai.
# These are IGNORED when PREFERRED_PROVIDER=anthropic (models are not remapped).
# BIG_MODEL="gpt-4.1"
# SMALL_MODEL="gpt-4.1-mini"

# Example Google mapping:
# PREFERRED_PROVIDER="google"
# BIG_MODEL="gemini-2.5-pro"
# SMALL_MODEL="gemini-2.5-flash"

# Example Google with vertex AI auth via ADC:
# PREFERRED_PROVIDER="google"
# USE_VERTEX_AUTH=true
# BIG_MODEL="gemini-2.5-pro"
# SMALL_MODEL="gemini-2.5-flash"

# Example "just an Anthropic proxy" mode:
# PREFERRED_PROVIDER="anthropic"
# (BIG_MODEL and SMALL_MODEL are ignored in this mode)

# Example NVIDIA NIM (no prefix; model id sent as-is to integrate.api.nvidia.com):
# PREFERRED_PROVIDER="nvidia_nim"
# NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_NIM_API_KEY="nvapi-your-key"
# BIG_MODEL="z.ai/glm4.7"
# SMALL_MODEL="z.ai/glm4.7"
#
# With nvidia_nim, tool results are sent as role="tool" messages (OpenAI-style). The proxy also
# supports extra_body (e.g. {"thinking": {"type": "enabled"}} or {"reasoning_budget": 16384}) to
# enable reasoning/thinking backends; reasoning_content is streamed as thinking blocks and included
# in non-streaming responses.
