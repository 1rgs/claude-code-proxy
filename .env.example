# ==================== Provider Selection ====================
PREFERRED_PROVIDER="nvidia_nim"
# Options: openai, gemini, anthropic, nvidia_nim

# ==================== OpenAI Config ====================
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"

# ==================== Google Gemini Config ====================
GEMINI_API_KEY="..."
# OR for Vertex AI with ADC:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Vertex AI config (alternative to API key)
USE_VERTEX_AUTH=false
VERTEX_PROJECT="your-project-id"
VERTEX_LOCATION="us-central1"

# ==================== Anthropic Config ====================
ANTHROPIC_API_KEY="sk-ant-..."

# ==================== NVIDIA NIM Config ====================
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_API_KEY="nvapi-..."

# NVIDIA NIM Rate Limiting (requests per minute)
NVIDIA_NIM_RATE_LIMIT=40

# ----- Useful NIM Parameters (optional) -----
# Core parameters
NVIDIA_NIM_TEMPERATURE=1.0
NVIDIA_NIM_TOP_P=1.0
NVIDIA_NIM_TOP_K=-1
NVIDIA_NIM_MAX_TOKENS=81920
NVIDIA_NIM_PRESENCE_PENALTY=0.0
NVIDIA_NIM_FREQUENCY_PENALTY=0.0

# Advanced parameters
NVIDIA_NIM_MIN_P=0.0
NVIDIA_NIM_REPETITION_PENALTY=1.0
NVIDIA_NIM_SEED=
NVIDIA_NIM_STOP=

# Flag parameters (true/false)
NVIDIA_NIM_PARALLEL_TOOL_CALLS=true
NVIDIA_NIM_RETURN_TOKENS_AS_TOKEN_IDS=false
NVIDIA_NIM_INCLUDE_STOP_STR_IN_OUTPUT=false
NVIDIA_NIM_IGNORE_EOS=false

NVIDIA_NIM_MIN_TOKENS=0
NVIDIA_NIM_CHAT_TEMPLATE=""
NVIDIA_NIM_REQUEST_ID=""

# ----- Thinking/Reasoning Parameters (passed via extra_body) -----
# These are merged into extra_body for requests
NVIDIA_NIM_REASONING_EFFORT=high
NVIDIA_NIM_INCLUDE_REASONING=true

# ==================== Model Mapping ====================
# For nvidia_nim: specify actual model IDs (no prefix)
# For others: anthropic/haiku -> SMALL_MODEL, anthropic/sonnet -> BIG_MODEL
BIG_MODEL="z-ai/glm4.7"
SMALL_MODEL="z-ai/glm4.7"

# Example OpenAI mapping:
# PREFERRED_PROVIDER="openai"
# BIG_MODEL="gpt-4.1"
# SMALL_MODEL="gpt-4.1-mini"

# Example Gemini mapping:
# PREFERRED_PROVIDER="gemini"
# BIG_MODEL="gemini-2.5-pro"
# SMALL_MODEL="gemini-2.5-flash"

# Example "just an Anthropic proxy" mode:
# PREFERRED_PROVIDER="anthropic"
# (BIG_MODEL and SMALL_MODEL are ignored in this mode)

# Example NVIDIA NIM (no prefix; model id sent as-is to integrate.api.nvidia.com):
# PREFERRED_PROVIDER="nvidia_nim"
# NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_NIM_API_KEY="nvapi-your-key"
# BIG_MODEL="z-ai/glm4.7"
# SMALL_MODEL="z-ai/glm4.7"
#
# With nvidia_nim, tool results are sent as role="tool" messages (OpenAI-style). The proxy also
# supports extra_body (e.g. {"thinking": {"type": "enabled"}} or {"reasoning_budget": 16384}) to
# enable reasoning/thinking backends; reasoning_content is streamed as thinking blocks and included
# in non-streaming responses.
