# ==================== NVIDIA NIM Config ====================
NVIDIA_NIM_API_KEY="nvapi-..."
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# ==================== Model Mapping ====================
# Claude Sonnet/Opus -> BIG_MODEL, Claude Haiku -> SMALL_MODEL
BIG_MODEL="qwen/qwen2.5-coder-32b-instruct"
SMALL_MODEL="qwen/qwen2.5-coder-32b-instruct"

# ==================== Rate Limiting ====================
NVIDIA_NIM_RATE_LIMIT=40        # Requests per window
NVIDIA_NIM_RATE_WINDOW=1        # Window in seconds (40 req/s = free tier)

# ==================== Optional NIM Parameters ====================
# These are passed to the NIM API if set

# Core parameters
# NVIDIA_NIM_TEMPERATURE=1.0
# NVIDIA_NIM_TOP_P=1.0
# NVIDIA_NIM_MAX_TOKENS=81920

# ==================== Fast Prefix Detection ====================
# Skip LLM call for Claude Code bash command prefix classification
FAST_PREFIX_DETECTION=true
